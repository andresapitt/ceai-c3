# Set these in Vercel: Project Settings > Environment Variables.
# Never commit real values. This file lists the names only.

# Required. From https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Optional. Defaults to gemini-2.5-flash.
# Check what your key can reach with /api/chat?selftest=1
GEMINI_MODEL=

# Required for the FAQ knowledge. The Google Sheet ID of the FAQ sheet,
# shared as "anyone with the link can view".
FAQ_SHEET_ID=
